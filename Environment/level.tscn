[sub_resource type="GDScript" id="GDScript_c08ot"]
resource_name = "MusicController"
script/source = "extends AudioStreamPlayer

@export var player: Player
@export var enemy: Enemy
var enemy_player_distance_sqrd: float


@export var high_prox_max: float = 15
var high_prox_max_sqrd: float
@export var med_prox_max: float = 30
var med_prox_max_sqrd: float

var playing_now: String = \"Low Proximity\"



# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	high_prox_max_sqrd = pow(high_prox_max, 2)
	med_prox_max_sqrd = pow(med_prox_max, 2)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if player and enemy:
		enemy_player_distance_sqrd = player.global_position.distance_squared_to(enemy.global_position)
		#print(str(sqrt(enemy_player_distance_sqrd)))
	
	if enemy_player_distance_sqrd <= high_prox_max_sqrd: # Player is high prox of enemy
		# Play high prox music
		switch_stream_stay_position(\"High Proximity\")
		#print(\"Playing is high prox, transitioning music to high prox.\")
	elif enemy_player_distance_sqrd <= med_prox_max_sqrd: #Player is med prox of enemy
		switch_stream_stay_position(\"Medium Proximity\")
		#print(\"Playing is medium prox, transitioning music to medium prox.\")
	else:
		switch_stream_stay_position(\"Low Proximity\")
		#print(\"Playing is low prox, transitioning music to low prox.\")

func switch_stream_stay_position(song_name: String) -> void:
	var p: AudioStreamPlaybackInteractive = get_stream_playback() 
	if playing_now == song_name: return
	playing_now = song_name
	p.switch_to_clip_by_name(song_name)
	print(\"Switching song to \" + song_name)
"

